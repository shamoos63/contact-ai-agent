# Dashboard login (used only the first time the app starts; change the password later in Settings)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# AI models (Ollama). Defaults work well for Arabic + English.
CHAT_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3

# When running without Docker, point to your local Ollama:
# OLLAMA_URL=http://localhost:11434

# Folder of .gguf models (LM Studio). Restart Docker after changing this.
# Windows: GGUF_HOST_DIR=C:/Users/you/.lmstudio/models
# Mac: GGUF_HOST_DIR=/Users/you/.lmstudio/models
# Leave unset to use the project's gguf folder.
