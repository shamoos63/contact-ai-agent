# Dashboard login (used only the first time the app starts; change the password later in Settings)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# AI models (Ollama). Defaults work well for Arabic + English.
CHAT_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3

# When running without Docker, point to your local Ollama:
# OLLAMA_URL=http://localhost:11434
